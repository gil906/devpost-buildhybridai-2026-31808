# PII-Zero — Firebase AI Logic Hybrid Inference SDK Configuration
# Optional build-time defaults; judges can also paste Firebase Web Config JSON live in the UI Setup Drawer (stored only in sessionStorage).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Firebase App Check (ReCaptcha Enterprise site key & local debug token)
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# HTTP Server Configuration
PORT=8764
HOST=0.0.0.0
