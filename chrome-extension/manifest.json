{
  "manifest_version": 3,
  "name": "PII-Zero: Zero-Trust Clinical & Legal Hybrid AI Airlock",
  "short_name": "PII-Zero Airlock",
  "version": "1.0.0",
  "description": "On-device Gemini Nano 4 HIPAA 18-identifier + Legal privilege airlock, SHA-256 zero-PII proof gatekeeper, and Cloud Gemini 2.5 Flash reasoning with local token re-hydration.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "action": {
    "default_title": "Open PII-Zero Hybrid AI Airlock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
